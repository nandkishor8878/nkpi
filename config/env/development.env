AURA_CAMERA_PROVIDER=mock
AURA_CAMERA_WIDTH=640
AURA_CAMERA_HEIGHT=480

AURA_SERIAL_TRANSPORT=mock
AURA_SERIAL_PORT=/dev/ttyUSB0
AURA_SERIAL_BAUDRATE=115200

AURA_SERVO_DRIVER=mock
AURA_SERVO_DEFAULT_CHANNEL=0
AURA_SERVO_MIN_ANGLE=30
AURA_SERVO_MAX_ANGLE=150
AURA_SERVO_LEFT_ANGLE=60
AURA_SERVO_CENTER_ANGLE=90
AURA_SERVO_RIGHT_ANGLE=120
AURA_SERVO_SMOOTH_STEP_DEGREES=2
AURA_SERVO_SMOOTH_STEP_DELAY_SECONDS=0.02
AURA_PCA9685_CHANNELS=16
AURA_PCA9685_I2C_ADDRESS=0x40

AURA_PROXIMITY_THRESHOLD_CM=50
